# Copy this file to .env for local development.
# In production (Render) set these as real environment variables instead -
# see render.yaml and README.md for the full deployment walkthrough.

PORT=4000

# Neon connection string (use the POOLED connection string from your Neon
# project's dashboard - "Connection Details" > toggle "Pooled connection").
# Looks like:
# postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pickfords_chaser

# Neon requires SSL. Only set this to false for a local non-SSL Postgres
# instance (e.g. the docker-compose.dev.yml one).
PGSSL=true

# PIN Chris/the admin device enters to unlock game-control actions
# (create game, advance question, view draw pool, void a result).
# MUST be set before the live event - without it, admin routes are open.
ADMIN_PIN=changeme2026

# Your Vercel deployment's origin, for CORS. Comma-separate prod + preview
# URLs if needed, e.g. "https://pickfords-chaser.vercel.app,https://pickfords-chaser-git-main-you.vercel.app"
FRONTEND_URL=https://your-app.vercel.app
